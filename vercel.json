{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "buildCommand": "bash ./netlify-build.sh",
  "outputDirectory": "dist",
  "framework": null,

  "trailingSlash": false,
  "cleanUrls": true,

  "redirects": [
    { "source": "/child-care-about-us",             "destination": "/",                                         "permanent": true },
    { "source": "/child-care-academy",              "destination": "/",                                         "permanent": true },
    { "source": "/child-care-classes",              "destination": "/",                                         "permanent": true },
    { "source": "/child-care-contact-us",           "destination": "/contact",                             "permanent": true },
    { "source": "/child-care-early-learning",       "destination": "/programs/infant-care",                "permanent": true },
    { "source": "/child-care-preschool",            "destination": "/programs/nyc-3k",                     "permanent": true },
    { "source": "/child-care-prices",               "destination": "/admissions/tuition-financial-assistance", "permanent": true },
    { "source": "/child-care-parties",              "destination": "/",                                         "permanent": true },
    { "source": "/child-care-play-space",           "destination": "/",                                         "permanent": true },
    { "source": "/child-care-playroom",             "destination": "/",                                         "permanent": true },
    { "source": "/child-care-terms-and-conditions", "destination": "/terms",                               "permanent": true }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(img|logo|fonts)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(video|docs)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
